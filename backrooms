local function applyVoiceEffects(s)
    if not s:IsA("Sound") then return end
    for _, n in ipairs({"BRVoiceEcho", "BRVoiceEQ", "BRVoiceReverb", "BRVoicePitch"}) do
        local e = s:FindFirstChild(n)
        if e then e:Destroy() end
    end

    local echo = Instance.new("EchoSoundEffect")
    echo.Name = "BRVoiceEcho"
    echo.DelayTime = 0.09
    echo.Feedback = 0.75
    echo.WetLevel = 0.7
    echo.DryLevel = 0.7
    echo.Parent = s

    local eq = Instance.new("EqualizerSoundEffect")
    eq.Name = "BRVoiceEQ"
    eq.LowGain = 2
    eq.MidGain = 0.5
    eq.HighGain = -3
    eq.Parent = s

    local rev = Instance.new("ReverbSoundEffect")
    rev.Name = "BRVoiceReverb"
    rev.DecayTime = 3.5
    rev.WetLevel = 0.6
    rev.DryLevel = 0.5
    rev.Density = 1
    rev.Diffusion = 1
    rev.Parent = s

    pcall(function()
        local pit = Instance.new("PitchShiftSoundEffect")
        pit.Name = "BRVoicePitch"
        pit.Octaves = -0.03
        pit.Parent = s
    end)
end

