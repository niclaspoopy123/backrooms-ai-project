    panel.Size = Vector3.new(11, 0.25, 5.5)
    panel.Position = Vector3.new(x, WALL_HEIGHT - 0.05, z)
    panel.Material = dead and Enum.Material.SmoothPlastic or Enum.Material.Neon
    if dead then
        panel.Color = level == 2 and Color3.fromRGB(66, 68, 74) or Color3.fromRGB(150, 145, 130)
    else
        if level == 2 then
            panel.Color = JitterColor(Color3.fromRGB(120, 132, 156), 0.10, rng)
        else
            local age = rng()
            if age < 0.2 then
                panel.Color = Color3.fromRGB(212, 198, 148) -- yellowed old diffuser
            else
                panel.Color = JitterColor(Color3.fromRGB(226, 216, 178), 0.05, rng)
            end
        end
    end
    panel.Parent = chunk

    if not IS_MOBILE then
        for _, d in ipairs({ Vector3.new(0, 0, 2.9), Vector3.new(0, 0, -2.9) }) do
            local f = Instance.new("Part")
            f.Size = Vector3.new(11.6, 0.18, 0.3)
            f.Position = Vector3.new(x, WALL_HEIGHT - 0.12, z) + d
            Ghost(f)
            f.Material = Enum.Material.Metal
            f.Color = Color3.fromRGB(168, 166, 158)
            f.Parent = chunk
        end
        for _, d in ipairs({ Vector3.new(5.7, 0, 0), Vector3.new(-5.7, 0, 0) }) do
            local f = Instance.new("Part")
            f.Size = Vector3.new(0.3, 0.18, 6.1)
            f.Position = Vector3.new(x, WALL_HEIGHT - 0.12, z) + d
            Ghost(f)
            f.Material = Enum.Material.Metal
            f.Color = Color3.fromRGB(168, 166, 158)
            f.Parent = chunk
        end
    end

    if dead then return end

    local light = Instance.new("PointLight")
    light.Shadows = not IS_MOBILE
    if level == 2 then
        light.Color = Color3.fromRGB(196, 210, 245)
        light.Range = 26
        light.Brightness = 0.6 * LIGHT_SCALE
    else
        -- real fluorescent installs vary: some warm/aging, most neutral
        local t = rng()
        if t < 0.15 then
            light.Color = Color3.fromRGB(255, 232, 182)   -- aging warm tube
        elseif t < 0.25 then
            light.Color = Color3.fromRGB(244, 248, 255)   -- cool replacement tube
        else
            light.Color = Color3.fromRGB(255, 247, 216)
        end
        light.Range = 34
        light.Brightness = 0.82 * LIGHT_SCALE
    end
    light.Parent = panel

    table.insert(data.Lights, { Light = light, Base = light.Brightness })
    RegisterLit(data.Key, panel.Position, light)

    -- dust motes only where a light cone exists (max 2 emitters per chunk)
    if (data.DustCount or 0) < 2 and rng() < 0.5 then
        data.DustCount = (data.DustCount or 0) + 1
        CreateDust(panel, Vector3.new(0, -1, 0), DUST_RATE * 0.75)
    end

    local buzz, buzzVol = nil, 0
    if not data.HasBuzz then
        data.HasBuzz = true
        buzz = Instance.new("Sound")
        buzz.SoundId = AUDIO_LEVEL_0
        buzzVol = (0.5 + rng() * 0.15) * MASTER
        buzz.Volume = buzzVol
        buzz.PlaybackSpeed = 0.97 + rng() * 0.06
        buzz.Looped = true
        buzz.SoundGroup = BRMasterGroup
        buzz.RollOffMode = Enum.RollOffMode.InverseTapered
        buzz.RollOffMaxDistance = 60
        pcall(function() buzz.RollOffMinDistance = 8 end)
        buzz.Parent = panel
        buzz:Play()
        table.insert(data.Buzzes, { S = buzz, V = buzzVol, P = buzz.PlaybackSpeed, Drift = not faulty, Ph = math.random() * 6.28 })
    end

    if faulty then
        local base = light.Brightness
        local setBuzz = function(b, vol)
            if buzz then
                buzz.Volume = buzzVol * math.clamp(b / base, 0, 1) * vol
            end
        end
        local function set(b)
            light.Brightness = b
            setBuzz(b, 1)
        end
        task.spawn(function()
            -- brief warm-up flicker when the tube first strikes
            for _ = 1, math.random(3, 6) do
                if not (RUNNING and panel.Parent and light.Parent) then return end
                set(math.random() < 0.5 and 0.03 or base * (0.4 + math.random() * 0.4))
                task.wait(0.03 + math.random() * 0.08)
            end
            local dimPhase = math.random() * 100
            local nextBurst = os.clock() + 1 + math.random() * 5
            while RUNNING and panel.Parent and light.Parent do
                if Blackout then
                    light.Brightness = 0
                    if buzz then buzz.Volume = 0 end
                    task.wait(0.15)
                else
                    -- slow dying-tube dim
                    local dim = 0.72 + 0.28 * (0.5 + 0.5 * math.sin(os.clock() * 0.35 + dimPhase))
                    local level0 = base * dim
                    if os.clock() >= nextBurst then
                        -- stutter burst
                        if math.random() < 0.4 then FlickerPop(panel.Position) end
                        for _ = 1, math.random(3, 8) do
                            if Blackout or not (RUNNING and panel.Parent and light.Parent) then break end
                            set(math.random() < 0.5 and 0.03 or level0)
                            if buzz then buzz.PlaybackSpeed = 0.95 + math.random() * 0.1 end
                            task.wait(0.02 + math.random() * 0.05)
                        end
                        nextBurst = os.clock() + 2 + math.random() * 8
                    else
                        local on = math.random() > 0.45
                        set(on and level0 or 0.03)
                        if buzz then buzz.PlaybackSpeed = 0.95 + math.random() * 0.1 end
                        task.wait(math.random(4, 35) / 100)
                    end
                end
            end
        end)
    end
end

