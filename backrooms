local function Ghost(p)
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    return p
end

local function Solid(p)
    p.Anchored = true
    p.CanCollide = true
    p.CastShadow = false
    return p
end

local function JitterColor(c, amt, rng)
    local j = 1 + (rng() - 0.5) * amt
    return Color3.new(
        math.clamp(c.R * j, 0, 1),
        math.clamp(c.G * j, 0, 1),
        math.clamp(c.B * j, 0, 1)
    )
end

local function ApplyTexture(part, textureId, face, color, studs, trans)
    local texture = Instance.new("Texture")
    texture.Texture = textureId
    texture.Face = face
    texture.StudsPerTileU = studs or 9
    texture.StudsPerTileV = studs or 9
    texture.Transparency = trans or 0
    texture.Parent = part
    part.Color = color
end

