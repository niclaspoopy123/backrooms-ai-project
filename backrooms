local function DoBlackout()
    if Blackout then return end
    Blackout = true
    PlayAt(HiveMind.PlayerPos + Vector3.new(0, 8, 0), CREAK_ID, 0.7, 0.4, 250, 3)
    PlayAt(HiveMind.PlayerPos + Vector3.new(0, 8, 0), THUMP_ID, 0.6, 0.3, 250, 3)
    for _, c in pairs(loadedChunks) do
        for _, L in ipairs(c.Lights) do
            if L.Light.Parent then L.Light.Brightness = 0 end
        end
        for _, b in ipairs(c.Buzzes) do
            if b.S.Parent then b.S.Volume = 0 end
        end
    end
    if HiveMind.CurrentLevel == 1 then
        task.delay(2, function()
            if Blackout and HiveMind.CurrentLevel == 1 then SpawnEyeMonster() end
        end)
    end
    task.delay(math.random(7, 12), function()
        local i = 0
        for _, c in pairs(loadedChunks) do
            for _, L in ipairs(c.Lights) do
                if L.Light.Parent then
                    i += 1
                    task.delay((i % 40) * 0.02 + math.random() * 0.6, function()
