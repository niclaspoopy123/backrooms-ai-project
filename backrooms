        st.Shape = Enum.PartType.Cylinder
        st.Size = Vector3.new(0.05, r, r)
        st.CFrame = CFrame.new(x + (rng() - 0.5) * 4, WALL_HEIGHT - 0.14, z + (rng() - 0.5) * 4) * CFrame.Angles(0, 0, math.rad(90))
        Ghost(st)
        st.Material = Enum.Material.SmoothPlastic
        st.Color = Color3.fromRGB(94, 74, 52)
        st.Transparency = 0.25
        st.Parent = chunk
    end

    if isLightTile then
        local lightPanel = Instance.new("Part")
        lightPanel.Name = "BRLightPanel"
        lightPanel.Size = Vector3.new(11, 0.2, 5)
        lightPanel.Position = Vector3.new(x, WALL_HEIGHT - 0.08, z)
        Ghost(lightPanel)
        lightPanel.Material = Enum.Material.Neon
        lightPanel.Color = Color3.fromRGB(232, 231, 220)
        lightPanel.Parent = chunk

        local light = Instance.new("PointLight")
        light.Color = level == 2 and Color3.fromRGB(190, 205, 255) or Color3.fromRGB(245, 239, 220)
        light.Range = 34
        light.Brightness = level == 2 and 1.1 or 1.8
        light.Shadows = not IS_MOBILE
        light.Parent = lightPanel

        local key = tostring(math.floor(x / CHUNK_SIZE + 0.5)) .. "_" .. tostring(math.floor(z / CHUNK_SIZE + 0.5))
        RegisterLit(key, lightPanel.Position, light)
    end

    return tile
end

local function BuildChunk(cx, cz)
    local chunk = Instance.new("Folder")
    chunk.Name = string.format("Chunk_%d_%d", cx, cz)
    chunk.Parent = MapFolder

    local data = { Lights = {} }
    local rng = MakeRNG(cx, cz)

    local floor = Instance.new("Part")
    floor.Name = "Floor"
    floor.Size = Vector3.new(CHUNK_SIZE, 1, CHUNK_SIZE)
    floor.Position = Vector3.new(cx * CHUNK_SIZE, 0, cz * CHUNK_SIZE)
    floor.Material = Enum.Material.SmoothPlastic
    floor.Color = Color3.fromRGB(190, 186, 176)
    floor.Anchored = true
    floor.Parent = chunk

    local ceiling = Instance.new("Part")
    ceiling.Name = "Ceiling"
    ceiling.Size = Vector3.new(CHUNK_SIZE, 1, CHUNK_SIZE)
    ceiling.Position = Vector3.new(cx * CHUNK_SIZE, WALL_HEIGHT + 1, cz * CHUNK_SIZE)
    ceiling.Material = Enum.Material.SmoothPlastic
    ceiling.Color = Color3.fromRGB(210, 206, 196)
    ceiling.Anchored = true
    ceiling.Parent = chunk

    for x = -CHUNK_SIZE / 2 + 8, CHUNK_SIZE / 2 - 8, WALL_SPACING do
        for z = -CHUNK_SIZE / 2 + 8, CHUNK_SIZE / 2 - 8, WALL_SPACING do
            CreateCeilingTile(chunk, data, cx * CHUNK_SIZE + x, cz * CHUNK_SIZE + z, 0, cx, cz, rng)
        end
    end

    local wallColor = Color3.fromRGB(212, 205, 188)
    local wallMaterial = Enum.Material.Fabric

    local minX = cx * CHUNK_SIZE - CHUNK_SIZE / 2
    local maxX = cx * CHUNK_SIZE + CHUNK_SIZE / 2
    local minZ = cz * CHUNK_SIZE - CHUNK_SIZE / 2
    local maxZ = cz * CHUNK_SIZE + CHUNK_SIZE / 2

    for i = 0, 3 do
        local idx = i + 1
        local x = (idx % 2 == 0) and minX or maxX
        local z = (idx % 2 == 0) and (minZ + (i * 10)) or (maxZ - (i * 10))
        local wall = Instance.new("Part")
        wall.Anchored = true
        wall.Material = wallMaterial
        wall.Size = Vector3.new(1, WALL_H, WALL_SPACING)
        wall.Position = Vector3.new(x, WALL_H / 2, z)
        wall.Color = wallColor
        wall.Parent = chunk
    end

    for i = 0, 3 do
        local idx = i + 1
        local x = (idx % 2 == 0) and (minX + (i * 10)) or (maxX - (i * 10))
        local z = (idx % 2 == 0) and minZ or maxZ
        local wall = Instance.new("Part")
        wall.Anchored = true
        wall.Material = wallMaterial
        wall.Size = Vector3.new(WALL_SPACING, WALL_H, 1)
        wall.Position = Vector3.new(x, WALL_H / 2, z)
        wall.Color = wallColor
        wall.Parent = chunk
    end

    return chunk
end

local function RefreshChunks()
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = Player.Character.HumanoidRootPart
    local cx = math.floor(root.Position.X / CHUNK_SIZE + 0.5)
    local cz = math.floor(root.Position.Z / CHUNK_SIZE + 0.5)

    for dx = -RENDER_RADIUS, RENDER_RADIUS do
        for dz = -RENDER_RADIUS, RENDER_RADIUS do
            local key = (cx + dx) .. "_" .. (cz + dz)
            if not loadedChunks[key] then
                local c = BuildChunk(cx + dx, cz + dz)
                loadedChunks[key] = c
            end
        end
    end

    for key, chunk in pairs(loadedChunks) do
        local x = tonumber(string.match(key, "^(.-)_")) or 0
        local z = tonumber(string.match(key, "_(.-)$")) or 0
        local dist = math.abs(x - cx) + math.abs(z - cz)
        if dist > UNLOAD_RADIUS then
            chunk:Destroy()
            loadedChunks[key] = nil
        end
    end
end

