RunService:BindToRenderStep("BackroomsEyeShake", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not RUNNING then return end
    local t = os.clock()

    local target = (Sprinting and 6) or 0
    SprintFOV = SprintFOV + (target - SprintFOV) * math.min(dt * 6, 1)
    local dreamWob = (HiveMind.CurrentLevel == 2) and math.sin(t * 0.6) * 1.2 or 0
    Camera.FieldOfView = FOV + SprintFOV + dreamWob

    if Flashlight.Part and Flashlight.Part.Parent then
        -- beam lags slightly behind the camera and sways a tiny bit
        local target = Camera.CFrame
        local rot = target.Rotation
        if Flashlight.Ready then
            rot = Flashlight.Part.CFrame.Rotation:Lerp(target.Rotation, math.min(dt * 16, 1))
        end
        Flashlight.Ready = true
        Flashlight.Part.CFrame = CFrame.new(target.Position) * rot
            * CFrame.Angles(math.sin(t * 1.3) * 0.004, math.cos(t * 1.1) * 0.004, 0)
        -- faint glare: lift bloom a touch while the flashlight is on
        local bloom = Lighting:FindFirstChild("BR_Bloom")
        if bloom then
            bloom.Intensity = bloom.Intensity + ((Flashlight.On and 0.22 or 0.15) - bloom.Intensity) * math.min(dt * 4, 1)
        end
    end

    local grain = HiveMind.Grain
    if grain and grain.Parent then
        grain.Position = UDim2.fromOffset(-math.random(0, 128), -math.random(0, 128))
    end

    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hSpeed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0

    BobPhase += dt * (4 + hSpeed * 0.55)
    local bobAmp = math.clamp(hSpeed / SPRINT_SPEED, 0, 1) * 0.16
    local bobY = math.sin(BobPhase) * bobAmp
    local bobRoll = math.sin(BobPhase * 0.5) * bobAmp * 0.25
    local idleY = math.sin(t * 1.1) * 0.02

    local eff = (os.clock() - NearestThreatTime < 0.5) and NearestThreat or 999
    local n = math.clamp(1 - eff / 26, 0, 1)
    local amp = n * n * 0.45

    if amp > 0.01 or bobAmp > 0.005 then
        Camera.CFrame = Camera.CFrame
            * CFrame.new(math.noise(t * 8, 1) * amp * 0.3, bobY + idleY + math.noise(1, t * 8) * amp * 0.3, 0)
            * CFrame.Angles(math.noise(t * 7, 5) * amp * 0.03, math.noise(5, t * 7) * amp * 0.03, bobRoll)
    end
end)

-- main streaming + atmosphere loop
task.spawn(function()
    while RUNNING do
        task.wait(0.2)
        UpdateHiveMind()
        local pos = HiveMind.PlayerPos
        local ccx = math.floor(pos.X / CHUNK_SIZE + 0.5)
        local ccz = math.floor(pos.Z / CHUNK_SIZE + 0.5)

        for dx = -RENDER_RADIUS, RENDER_RADIUS do
            for dz = -RENDER_RADIUS, RENDER_RADIUS do
                if dx * dx + dz * dz <= RENDER_RADIUS * RENDER_RADIUS then
                    QueueChunk(ccx + dx, ccz + dz)
                end
            end
        end

        for name, c in pairs(loadedChunks) do
            local dx = c.CX - ccx
            local dz = c.CZ - ccz
            if dx * dx + dz * dz > UNLOAD_RADIUS * UNLOAD_RADIUS then
                UnloadChunk(name)
            end
        end

        local built = 0
        local t0 = os.clock()
        while #chunkQueue > 0 and built < BUILD_PER_FRAME and os.clock() - t0 < BUILD_TIME_BUDGET do
            local bi, bd = 1, math.huge
            for i, q in ipairs(chunkQueue) do
                local d = (q[1] - ccx) ^ 2 + (q[2] - ccz) ^ 2
                if d < bd then bi, bd = i, d end
            end
            local q = table.remove(chunkQueue, bi)
            queuedSet[q[1] .. "_" .. q[2]] = nil
            BuildChunkInstant(q[1], q[2])
            built += 1
        end

        UpdateAtmosphere(math.sqrt(ccx * ccx + ccz * ccz))
    end
end)

