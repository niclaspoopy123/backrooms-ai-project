-- 🧰 PROP HELPERS ---------------------------------------------------------
local function Ghost(p)
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    return p
end

local function Solid(p)
    p.Anchored = true
    p.CanCollide = true
    p.CastShadow = false
    return p
end

local function JitterColor(c, amt, rng)
    local j = 1 + (rng() - 0.5) * amt
    return Color3.new(math.clamp(c.R * j, 0, 1), math.clamp(c.G * j, 0, 1), math.clamp(c.B * j, 0, 1))
end

-- per-chunk texture variation, set at the start of each chunk build
local TexVar = nil

local function ApplyTexture(part, textureId, face, color, studs, trans)
    local texture = Instance.new("Texture")
    texture.Texture = textureId
    texture.Face = face
    local u, v = studs or 9, studs or 9
    if TexVar then
        u, v = u * TexVar.U, v * TexVar.V
        color = JitterColor(color, TexVar.Tint, TexVar.Rng)
    end
    texture.StudsPerTileU = u
    texture.StudsPerTileV = v
    texture.Transparency = trans or 0
    texture.Parent = part
    part.Color = color
    -- subtle dirt / stain layer on level 0 carpet and walls
    if TexVar and TexVar.Dirt and TexVar.Rng() < (IS_MOBILE and 0.12 or 0.3) then
        local dirt = Instance.new("Texture")
        dirt.Texture = textureId
        dirt.Face = face
        dirt.StudsPerTileU = u * (1.6 + TexVar.Rng())
        dirt.StudsPerTileV = v * (1.6 + TexVar.Rng())
        dirt.OffsetStudsU = TexVar.Rng() * u
        dirt.OffsetStudsV = TexVar.Rng() * v
        dirt.Color3 = Color3.fromRGB(96, 72, 44)
        dirt.Transparency = 0.84 + TexVar.Rng() * 0.08
        dirt.Parent = part
    end
end

