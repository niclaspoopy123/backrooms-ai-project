local function UpdateAtmosphere(distFromCenter)
    if not (sounds.Lvl0 and sounds.Lvl2 and sounds.Lvl3) then return end

    local alpha2 = math.clamp((distFromCenter - LEVEL_2_DISTANCE) / 2, 0, 1)
    local alpha3 = math.clamp((distFromCenter - LEVEL_3_DISTANCE) / 2, 0, 1)

    sounds.Lvl0.Volume = (1 - alpha2) * 0.4 * MASTER
    sounds.Lvl2.Volume = alpha2 * (1 - alpha3) * 0.62 * MASTER
    sounds.Lvl3.Volume = alpha3 * 0.75 * MASTER

    if atmosphereEffect then
        local c1 = Color3.fromRGB(214, 206, 170)
        local c2 = Color3.fromRGB(22, 23, 30)
        local c3 = Color3.fromRGB(236, 228, 250)
        atmosphereEffect.Color = c1:Lerp(c2, alpha2):Lerp(c3, alpha3)

        local d1 = Color3.fromRGB(118, 108, 72)
        local d2 = Color3.fromRGB(7, 7, 9)
        local d3 = Color3.fromRGB(186, 182, 208)
        atmosphereEffect.Decay = d1:Lerp(d2, alpha2):Lerp(d3, alpha3)
        atmosphereEffect.Density = 0.28 + alpha2 * 0.30 - alpha3 * 0.10
        atmosphereEffect.Haze = 1.0 + alpha2 * 1.3 + alpha3 * 0.8
        atmosphereEffect.Glare = alpha3 * 0.2

        if sunRaysEffect then
            sunRaysEffect.Intensity = alpha3 * 0.3
        end
    else
        local color1 = Color3.fromRGB(198, 188, 146)
        local color2 = Color3.fromRGB(24, 25, 32)
        local colorD = Color3.fromRGB(230, 222, 248)
        Lighting.FogColor = color1:Lerp(color2, alpha2):Lerp(colorD, alpha3)

        local baseFog = RENDER_RADIUS * CHUNK_SIZE - 30
        local fogEnd = baseFog * (1 - alpha2 * 0.45)
        fogEnd = fogEnd + alpha3 * (baseFog * 1.15 - fogEnd)
        Lighting.FogEnd = fogEnd
        Lighting.FogStart = 50 - alpha2 * 24 + alpha3 * 70
    end

    local amb = Color3.fromRGB(112, 105, 86)
        :Lerp(Color3.fromRGB(10, 11, 17), alpha2)
        :Lerp(Color3.fromRGB(200, 196, 210), alpha3)
    if Blackout then amb = amb * 0.15 end
    Lighting.Ambient = amb

    Lighting.OutdoorAmbient = Color3.fromRGB(108, 100, 77)
        :Lerp(Color3.fromRGB(16, 18, 25), alpha2)
        :Lerp(Color3.fromRGB(233, 229, 245), alpha3)

    Lighting.Brightness = 1.6 - alpha2 * 0.62 + alpha3 * 0.3

    pcall(function()
        Lighting.ExposureCompensation = 0.08 - alpha2 * 0.22 + alpha3 * 0.12
    end)

    if ccEffect then
        ccEffect.Brightness = 0.01 - alpha2 * 0.10 + alpha3 * 0.14
        ccEffect.Saturation = -0.03 - alpha2 * 0.28 + alpha3 * 0.5
        ccEffect.Contrast = 0.04 + alpha2 * 0.08

        local tint1 = Color3.fromRGB(255, 251, 240)
        local tint2 = Color3.fromRGB(228, 234, 250)
        local t3
        if alpha3 > 0.5 then
            local w = math.sin(os.clock() * 0.4) * 0.5 + 0.5
            t3 = Color3.fromRGB(252, 248, 232):Lerp(Color3.fromRGB(240, 220, 255), w)
        else
            t3 = Color3.fromRGB(252, 248, 232)
        end
        ccEffect.TintColor = tint1:Lerp(tint2, alpha2):Lerp(t3, alpha3)
    end

    if blurEffect then
        local target = alpha3 > 0.5 and (1.2 + math.sin(os.clock() * 0.5) * 1.2) or 0
        blurEffect.Size = blurEffect.Size + (target - blurEffect.Size) * 0.1
    end

    if dofEffect then
        local want = (alpha2 > 0.5 and alpha3 < 0.5) and 0.32 or (alpha3 > 0.5 and 0.16 or 0)
        dofEffect.FarIntensity = dofEffect.FarIntensity + (want - dofEffect.FarIntensity) * 0.06
    end

    if alpha3 > 0.5 then
        HiveMind.CurrentLevel = 2
    elseif alpha2 > 0.5 then
        HiveMind.CurrentLevel = 1
    else
        HiveMind.CurrentLevel = 0
    end

    if HiveMind.CurrentLevel ~= lastAcousticLevel then
        lastAcousticLevel = HiveMind.CurrentLevel
        UpdateFootstepAcoustics(HiveMind.CurrentLevel)
    end

    local wantReverb = (HiveMind.CurrentLevel == 2 and "Hall")
        or (HiveMind.CurrentLevel == 1 and "Cave")
        or "Sewer"
    if wantReverb ~= currentReverb then applyReverb(wantReverb) end
end

