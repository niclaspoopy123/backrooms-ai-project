local function CreateLandmark(chunk, data, pos, level, rng)
    if level == 1 then
        local roll = rng()
        if roll < 0.15 and pos.Magnitude > 90 then
            CreateVendingDecor(chunk, pos + Vector3.new(-8, 0, -6), rng)
            local breakTable = Instance.new("Part")
            breakTable.Shape = Enum.PartType.Cylinder
            breakTable.Size = Vector3.new(0.4, 6, 6)
            breakTable.CFrame = CFrame.new(pos.X + 4, 1.8, pos.Z + 4)
            Solid(breakTable)
            breakTable.Material = Enum.Material.Wood
            breakTable.Color = Color3.fromRGB(110, 82, 52)
            breakTable.Parent = chunk
            CreateOfficeChair(chunk, pos + Vector3.new(8, 0, 4), rng)
            CreateOfficeChair(chunk, pos + Vector3.new(4, 0, 9), rng)
            CreateWaterCooler(chunk, pos + Vector3.new(9, 0, -5), rng)
            CreateCoffeeCup(chunk, pos + Vector3.new(5, 0, 5), rng)
            CreateCoffeeCup(chunk, pos + Vector3.new(3, 0, 6), rng)
            CreateBox(chunk, pos + Vector3.new(-6, 0, 8), rng)
            -- radio on the break room table: 1 in 1000
            if rng() < RADIO_CHANCE then
                CreateRadio(chunk, Vector3.new(pos.X + 4, 2.0, pos.Z + 4), rng)
            end
        elseif roll < 0.5 then
            local roomSize = 20 + math.floor(rng() * 11)
            for x = -roomSize / 2, roomSize / 2, 12 do
                for z = -roomSize / 2, roomSize / 2, 12 do
                    CreateDesk(chunk, pos + Vector3.new(x, 0, z), rng)
                    if rng() < 0.5 then CreateOfficeChair(chunk, pos + Vector3.new(x + 5, 0, z + 2), rng) end
                    if rng() < 0.35 then CreateFilingCabinet(chunk, pos + Vector3.new(x - 6, 0, z - 5), rng) end
                    if rng() < 0.3 then CreateBox(chunk, pos + Vector3.new(x + 3, 0, z - 6), rng) end
                    if rng() < 0.3 then CreateCoffeeCup(chunk, pos + Vector3.new(x + 1, 0, z + 1), rng) end
                    if rng() < 0.3 then CreatePaper(chunk, pos + Vector3.new(x - 2, 0, z + 3), rng) end
                end
            end
            -- radio on the center desk: 1 in 1000
            if rng() < RADIO_CHANCE then
                CreateRadio(chunk, Vector3.new(pos.X, 2.85, pos.Z), rng)
            end
            for _ = 1, 4 do
                CreateDebris(chunk, pos + Vector3.new(math.floor(rng() * roomSize) - roomSize / 2, 1, math.floor(rng() * roomSize) - roomSize / 2), rng)
            end
        end
    elseif level == 2 then
        if rng() < 0.6 then
            local machine = Instance.new("Part")
            machine.Size = Vector3.new(25, 25, 25)
            machine.Position = pos + Vector3.new(0, 12.5, 0)
            Solid(machine)
            machine.Material = Enum.Material.Metal
            machine.Color = Color3.fromRGB(90, 90, 95)
            machine.Parent = chunk
            CreateSteam(machine, Vector3.new(0, 12, 0))
            for _ = 1, 3 do
                local pick = rng()
                if pick < 0.4 then
                    CreateBarrel(chunk, pos + Vector3.new(math.floor(rng() * 25) - 12, 0, math.floor(rng() * 25) - 12), rng)
                elseif pick < 0.7 then
                    CreateCrate(chunk, pos + Vector3.new(math.floor(rng() * 25) - 12, 0, math.floor(rng() * 25) - 12), rng)
                else
                    CreateDebris(chunk, pos + Vector3.new(math.floor(rng() * 25) - 12, 1, math.floor(rng() * 25) - 12), rng)
                end
            end
        end
    elseif level == 3 and rng() < 0.6 then
        local plaza = Instance.new("Part")
        plaza.Size = Vector3.new(28, 0.4, 28)
        plaza.Position = pos + Vector3.new(0, 0.2, 0)
        Ghost(plaza)
        plaza.Material = Enum.Material.Glass
        plaza.Color = Color3.fromRGB(130, 240, 255)
        plaza.Transparency = 0.3
        plaza.Parent = chunk
        for _, corner in ipairs({ Vector3.new(12, 0, 12), Vector3.new(-12, 0, 12), Vector3.new(12, 0, -12), Vector3.new(-12, 0, -12) }) do
            local pillar = Instance.new("Part")
            pillar.Size = Vector3.new(3, 10, 3)
            pillar.Position = pos + corner + Vector3.new(0, 5, 0)
            Solid(pillar)
            pillar.Material = Enum.Material.SmoothPlastic
            pillar.Color = DREAM_PASTELS[1 + math.floor(rng() * #DREAM_PASTELS)]
            pillar.Parent = chunk
        end
        for _ = 1, 3 do
            local orb = Instance.new("Part")
            orb.Shape = Enum.PartType.Ball
            orb.Size = Vector3.new(2, 2, 2)
            orb.Position = pos + Vector3.new(math.floor(rng() * 21) - 10, 5 + math.floor(rng() * 6), math.floor(rng() * 21) - 10)
            Ghost(orb)
            orb.Material = Enum.Material.Neon
            orb.Color = DREAM_PASTELS[1 + math.floor(rng() * #DREAM_PASTELS)]
            orb.Parent = chunk
        end
    end
end

-- ▶️ CHUNK BUILDER --------------------------------------------------------
local function BuildChunkInstant(cx, cz)
    local chunkName = cx .. "_" .. cz
    if loadedChunks[chunkName] then return end
    queuedSet[chunkName] = nil

    local rng = MakeRNG(cx, cz)
    local distFromCenter = math.sqrt(cx * cx + cz * cz)
    local isLevel2 = distFromCenter >= LEVEL_2_DISTANCE
    local isLevel3 = distFromCenter >= LEVEL_3_DISTANCE

    local chunk = Instance.new("Model")
    chunk.Name = chunkName
    local data = { Model = chunk, CX = cx, CZ = cz, Key = chunkName, Lights = {}, Buzzes = {}, Animations = {} }

    local wTex, fTex, wCol, fCol, level, wallMaterial
    if isLevel3 then
        level = 3
        wTex = TEX_WALL_DREAM; fTex = TEX_FLOOR_0
        wCol = DREAM_PASTELS[1 + math.floor(rng() * #DREAM_PASTELS)]
        fCol = Color3.fromRGB(238, 236, 248)
        wallMaterial = Enum.Material.SmoothPlastic
    elseif isLevel2 then
        level = 2
        wTex = TEX_WALL_2; fTex = TEX_FLOOR_2
        wCol = Color3.fromRGB(98, 96, 100)
        fCol = Color3.fromRGB(72, 71, 74)
        wallMaterial = Enum.Material.Concrete
    else
        level = 1
        wTex = WallTex.Current; fTex = TEX_FLOOR_0
        wCol = Color3.fromRGB(176, 166, 118)
        fCol = JitterColor(Color3.fromRGB(138, 128, 90), 0.12, rng) -- worn carpet variation
        wallMaterial = Enum.Material.Plastic -- lower specular than SmoothPlastic
    end

    TexVar = {
        U = 0.85 + rng() * 0.3,
        V = 0.85 + rng() * 0.3,
        Tint = 0.06 + rng() * 0.06,
        Dirt = level == 1,
        Rng = rng,
    }

    local floor = Instance.new("Part")
    Solid(floor)
    floor.Size = Vector3.new(CHUNK_SIZE, 1, CHUNK_SIZE)
    floor.Position = Vector3.new(cx * CHUNK_SIZE, -0.5, cz * CHUNK_SIZE)
    floor.Material = (isLevel3 and Enum.Material.SmoothPlastic)
        or (isLevel2 and Enum.Material.DiamondPlate)
        or Enum.Material.Fabric
    ApplyTexture(floor, fTex, Enum.NormalId.Top, fCol, isLevel2 and 4 or 5, 0.2)
    floor.Parent = chunk

    if isLevel3 then
        for _ = 1, 2 + math.floor(rng() * 3) do
            CreateCloud(chunk, cx * CHUNK_SIZE + math.floor(rng() * 51) - 25, cz * CHUNK_SIZE + math.floor(rng() * 51) - 25, rng)
        end
        if rng() < 0.15 then
            CreateSunFace(chunk, data, cx * CHUNK_SIZE + math.floor(rng() * 41) - 20, cz * CHUNK_SIZE + math.floor(rng() * 41) - 20, rng)
        end
        local r = rng()
        if r < 0.10 then
            CreateSkyDoor(chunk, data, cx * CHUNK_SIZE + math.floor(rng() * 31) - 15, cz * CHUNK_SIZE + math.floor(rng() * 31) - 15, rng)
        elseif r < 0.18 then
            CreateDreamPool(chunk, data, cx * CHUNK_SIZE + math.floor(rng() * 21) - 10, cz * CHUNK_SIZE + math.floor(rng() * 21) - 10, rng)
        elseif r < 0.26 then
            CreateCRT(chunk, data, cx * CHUNK_SIZE + math.floor(rng() * 31) - 15, cz * CHUNK_SIZE + math.floor(rng() * 31) - 15, rng)
        elseif r < 0.33 then
            CreateSlide(chunk, data, cx * CHUNK_SIZE + math.floor(rng() * 21) - 10, cz * CHUNK_SIZE + math.floor(rng() * 21) - 10, rng)
        elseif r < 0.41 then
            CreateCheckerFloor(chunk, cx * CHUNK_SIZE, cz * CHUNK_SIZE)
        elseif r < 0.47 then
            CreateSkyEye(chunk, cx * CHUNK_SIZE + math.floor(rng() * 41) - 20, cz * CHUNK_SIZE + math.floor(rng() * 41) - 20, rng)
        elseif r < 0.54 then
            CreateTree(chunk, cx * CHUNK_SIZE + math.floor(rng() * 31) - 15, cz * CHUNK_SIZE + math.floor(rng() * 31) - 15, rng)
        end
    end

    local cells = CHUNK_SIZE / WALL_SPACING
    local originX = cx * CHUNK_SIZE - CHUNK_SIZE / 2
    local originZ = cz * CHUNK_SIZE - CHUNK_SIZE / 2

    for lx = 0, cells - 1 do
        for lz = 0, cells - 1 do
            local gx = cx * cells + lx
            local gz = cz * cells + lz
            local cellX = originX + lx * WALL_SPACING + WALL_SPACING / 2
            local cellZ = originZ + lz * WALL_SPACING + WALL_SPACING / 2

            if level == 3 then
                if gx % 2 == 0 and gz % 2 == 0 then
                    CreateDreamOrb(chunk, data, cellX, cellZ, rng)
                end
            else
                CreateCeilingTile(chunk, data, cellX, cellZ, level, gx, gz, rng)
            end

            local roomNoise = math.noise((cellX + SEED) / 110, (cellZ + SEED) / 110, SEED_C)
            local isOpenRoom = roomNoise > 0.34
            local nearSpawn = math.abs(cellX) < 24 and math.abs(cellZ) < 24

            if isOpenRoom then
                if not nearSpawn and (gx + gz) % 3 == 0 then
                    local pillar = Instance.new("Part")
                    Solid(pillar)
                    pillar.Size = Vector3.new(3, WALL_H, 3)
                    pillar.Position = Vector3.new(cellX, WALL_H / 2, cellZ)
                    pillar.Material = wallMaterial
                    pillar.Color = wCol
                    pillar.Parent = chunk
                end
                if not nearSpawn then
                    local r = rng()
                    if level == 1 then
                        if r < 0.025 then
                            CreateOfficeChair(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.035 then
                            CreateWaterCooler(chunk, Vector3.new(cellX + 2, 0, cellZ + 2), rng)
                        elseif r < 0.050 then
                            CreateFilingCabinet(chunk, Vector3.new(cellX - 3, 0, cellZ), rng)
                        elseif r < 0.080 then
                            CreateBox(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.095 then
                            CreateCoffeeCup(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.103 then
                            CreateWetFloorSign(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.16 then
                            CreatePaper(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.26 then
                            CreateStain(chunk, cellX, cellZ, rng)
                        end
                    elseif level == 2 then
                        if r < 0.10 then
                            CreatePuddle(chunk, cellX, cellZ, rng)
                        elseif r < 0.13 then
                            CreateBarrel(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.16 then
                            CreateCrate(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.175 then
                            CreatePallet(chunk, Vector3.new(cellX, 0, cellZ), rng)
                        elseif r < 0.26 then
                            CreateStain(chunk, cellX, cellZ, rng)
                        end
                    end
                    -- legendary floor radio: 1 in 1000 open cells
                    if (level == 1 or level == 2) and rng() < RADIO_CHANCE then
                        CreateRadio(chunk, Vector3.new(cellX, 0, cellZ), rng)
                    end
                end
            elseif not nearSpawn then
                local ex = cellX + WALL_SPACING / 2
                local vN = math.noise(gx / 7, gz / 23, SEED_A)
                if math.abs(vN) < EDGE_WALL_EPS
                    and not (math.abs(ex) < 24 and math.abs(cellZ) < 24) then
                    if rng() < DOORWAY_CHANCE then
                        CreateDoorway(chunk, true, ex, cellZ, wTex, wCol, wallMaterial, rng)
                    else
                        local wall = CreateWallPart(chunk, true, ex, cellZ, wTex, wCol, wallMaterial, rng)
                        if level == 1 then
                            local baseboard = Instance.new("Part")
                            baseboard.Size = Vector3.new(wall.Size.X + 0.24, 1.2, wall.Size.Z + 0.24)
                            baseboard.Position = Vector3.new(wall.Position.X, 0.6, wall.Position.Z)
                            Solid(baseboard)
                            baseboard.Material = Enum.Material.Wood
                            baseboard.Color = Color3.fromRGB(96, 76, 48)
                            baseboard.Parent = chunk
                            if rng() < 0.30 then CreateMolding(chunk, wall) end
                            local wr = rng()
                            if wr < 0.06 then CreateOutlet(chunk, wall, true)
                            elseif wr < 0.14 then CreateLightSwitch(chunk, wall, true)
                            elseif wr < 0.155 then CreateWallClock(chunk, wall, true, rng)
                            elseif wr < 0.165 then CreateCorkBoard(chunk, wall, true, rng)
                            elseif wr < 0.175 then CreateWhiteboard(chunk, wall, true, rng)
                            elseif wr < 0.20 then CreateWallScuff(chunk, wall, true, rng) end
                            if rng() < 0.025 then CreateExitSign(chunk, wall) end
                        elseif level == 2 then
                            if rng() < EYE_SPAWN_CHANCE then
                                CreateEye(chunk, wall.Position + Vector3.new(0.7, 1, 0))
                            end
                            if rng() < 0.35 then CreatePipes(chunk, wall.Position, true, rng) end
                            if rng() < 0.08 then CreateWires(chunk, wall.Position, rng) end
                            if rng() < 0.04 then CreateFuseBox(chunk, wall, true) end
                            if rng() < 0.10 then CreateStain(chunk, wall.Position.X, wall.Position.Z, rng) end
                        elseif level == 3 then
                            DecorateLevel3(chunk, wall, true, rng)
                        end
                    end
                end

                local sz = cellZ + WALL_SPACING / 2
                local hN = math.noise(gx / 23, gz / 7, SEED_B)
                if math.abs(hN) < EDGE_WALL_EPS
                    and not (math.abs(cellX) < 24 and math.abs(sz) < 24) then
                    if rng() < DOORWAY_CHANCE then
                        CreateDoorway(chunk, false, cellX, sz, wTex, wCol, wallMaterial, rng)
                    else
                        local wall = CreateWallPart(chunk, false, cellX, sz, wTex, wCol, wallMaterial, rng)
                        if level == 1 then
                            local baseboard = Instance.new("Part")
                            baseboard.Size = Vector3.new(wall.Size.X + 0.24, 1.2, wall.Size.Z + 0.24)
                            baseboard.Position = Vector3.new(wall.Position.X, 0.6, wall.Position.Z)
                            Solid(baseboard)
                            baseboard.Material = Enum.Material.Wood
                            baseboard.Color = Color3.fromRGB(96, 76, 48)
                            baseboard.Parent = chunk
                            if rng() < 0.30 then CreateMolding(chunk, wall) end
                            local wr = rng()
                            if wr < 0.06 then CreateOutlet(chunk, wall, false)
                            elseif wr < 0.14 then CreateLightSwitch(chunk, wall, false)
                            elseif wr < 0.155 then CreateWallClock(chunk, wall, false, rng)
                            elseif wr < 0.165 then CreateCorkBoard(chunk, wall, false, rng)
                            elseif wr < 0.175 then CreateWhiteboard(chunk, wall, false, rng)
                            elseif wr < 0.20 then CreateWallScuff(chunk, wall, false, rng) end
                            if rng() < 0.025 then CreateExitSign(chunk, wall) end
                        elseif level == 2 then
                            if rng() < EYE_SPAWN_CHANCE then
                                CreateEye(chunk, wall.Position + Vector3.new(0, 1, 0.7))
                            end
                            if rng() < 0.35 then CreatePipes(chunk, wall.Position, false, rng) end
                            if rng() < 0.08 then CreateWires(chunk, wall.Position, rng) end
                            if rng() < 0.04 then CreateFuseBox(chunk, wall, false) end
                            if rng() < 0.10 then CreateStain(chunk, wall.Position.X, wall.Position.Z, rng) end
                        elseif level == 3 then
                            DecorateLevel3(chunk, wall, false, rng)
                        end
                    end
                end
            end
        end
    end

    local center = Vector3.new(cx * CHUNK_SIZE, 0, cz * CHUNK_SIZE)
    local far = math.abs(cx) > 1 or math.abs(cz) > 1
    if far then
        CreateLandmark(chunk, data, center, level, rng)
        if level == 1 and rng() < 0.05 then
            local elevator = Instance.new("Part")
            elevator.Size = Vector3.new(4, 10, 4)
            elevator.Position = center + Vector3.new(20, 5, 20)
            Solid(elevator)
            elevator.Material = Enum.Material.Metal
            elevator.Color = Color3.fromRGB(150, 150, 150)
            elevator.Parent = chunk
            local door = Instance.new("Part")
            door.Size = Vector3.new(4, 10, 0.2)
            door.Position = elevator.Position + Vector3.new(0, 0, 2)
            Ghost(door)
            door.Material = Enum.Material.Metal
            door.Color = Color3.fromRGB(130, 130, 130)
            door.Parent = chunk
            elevator.Touched:Connect(function(hit)
                local char = Player.Character
                if char and hit.Parent == char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        PlayAt(elevator.Position, CREAK_ID, 0.6, 1.2, 60, 3)
                        root.CFrame = CFrame.new(0, 5, 0)
                    end
                end
            end)
        end
    end

    loadedChunks[chunkName] = data
    chunk.Parent = MapFolder
end

