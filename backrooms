    m.Parent = monsterFolder

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(4, 0, 4, 0)
    bb.Adornee = m
    bb.Parent = m
    local img = Instance.new("ImageLabel")
    img.Image = EYE_IMAGE
    img.Size = UDim2.new(1, 0, 1, 0)
    img.BackgroundTransparency = 1
    img.Parent = bb

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(255, 0, 0)
    light.Range = 10
    light.Brightness = 1
    light.Parent = m

    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxassetid://243660364"
    pe.Rate = 4
    pe.Lifetime = NumberRange.new(0.6, 1.2)
    pe.Speed = NumberRange.new(1, 3)
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0.2) })
    pe.Color = ColorSequence.new(Color3.fromRGB(255, 40, 40))
    pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
    pe.Parent = m

    local drone = Instance.new("Sound")
    drone.SoundId = CREAK_ID
    drone.Looped = true
    drone.PlaybackSpeed = 0.35
    drone.Volume = 0
    addEQ(drone, 8, -4, -10)
    drone.RollOffMode = Enum.RollOffMode.InverseTapered
    drone.RollOffMaxDistance = 90
    pcall(function() drone.RollOffMinDistance = 10 end)
    drone.Parent = m
    drone:Play()

    PlayAt(m.Position, CREAK_ID, 0.45, 0.8, 160, 3)

    task.spawn(function()
        local baseY = m.Position.Y
        local t = 0
        local wasScared = false
        local graceUntil = os.clock() + EYE_MONSTER_SPAWN_GRACE
        while RUNNING and m.Parent do
            local dt = task.wait(0.1)
            t += dt
            local char = Player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local offset = root.Position - m.Position
                local d = offset.Magnitude
                NearestThreat = d
                NearestThreatTime = os.clock()

                if HiveMind.CurrentLevel ~= 1 then
                    m.Position += Vector3.new(0, 40 * dt, 0)
                    drone.Volume = math.max(0, drone.Volume - dt)
                    if m.Position.Y > 80 then m:Destroy() break end
                else
                    if d > 170 then m:Destroy() break end

                    local safe = GetPlayerLightSafety()
                    local scared = safe and d < 34

                    if scared ~= wasScared then
                        wasScared = scared
                        if scared then
                            PlayAt(m.Position, CREAK_ID, 0.6, 1.9, 100, 2)
                            light.Color = Color3.fromRGB(120, 30, 30)
                            light.Brightness = 0.35
                            TweenService:Create(m, TweenInfo.new(0.4), { Size = Vector3.new(1.8, 1.8, 1.8) }):Play()
                        else
                            light.Color = Color3.fromRGB(255, 0, 0)
                            light.Brightness = 1
                            TweenService:Create(m, TweenInfo.new(0.4), { Size = Vector3.new(2.4, 2.4, 2.4) }):Play()
                        end
                    end

                    if d < EYE_MONSTER_KILL_RANGE and not safe and os.clock() > graceUntil then
                        DoKill()
                        m:Destroy()
                        break
                    end

                    local dir = offset.Unit
                    local camDot = Camera.CFrame.LookVector:Dot(-dir)
                    local frozen = camDot >= 0.55

                    if scared then
                        if d < 34 then
                            m.Position = m.Position - dir * (EYE_MONSTER_SPEED * 0.9) * dt
                        end
                    elseif not frozen then
                        local speed = EYE_MONSTER_SPEED * (1 + math.clamp((60 - d) / 60, 0, 1) * 0.8)
                        m.Position += dir * speed * dt
                    end

                    local shiver = scared and math.sin(t * 30) * 0.25 or 0
                    m.Position = Vector3.new(m.Position.X + shiver, baseY + math.sin(t * 2) * 0.8, m.Position.Z + shiver * 0.5)
                    drone.Volume = math.clamp(1 - d / 70, 0, 1) * 0.7 * MASTER
                end
            end
        end
    end)
end

