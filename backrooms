local function RegisterLit(key, pos, light)
    litLights[key] = litLights[key] or {}
    table.insert(litLights[key], { Pos = pos, Light = light })
end

local function GetPlayerLightSafety()
    local p = HiveMind.PlayerPos
    if p.Y > 9 then return false end
    local ccx = math.floor(p.X / CHUNK_SIZE + 0.5)
    local ccz = math.floor(p.Z / CHUNK_SIZE + 0.5)
    for dx = -1, 1 do
        for dz = -1, 1 do
            local list = litLights[(ccx + dx) .. "_" .. (ccz + dz)]
            if list then
                for _, entry in ipairs(list) do
                    if entry.Light.Parent and entry.Light.Brightness > 0.35 then
                        local horiz = Vector3.new(entry.Pos.X - p.X, 0, entry.Pos.Z - p.Z).Magnitude
                        if horiz < LIGHT_SAFE_RADIUS then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function addEQ(s, lo, mid, hi)
    local eq = Instance.new("EqualizerSoundEffect")
    eq.LowGain = lo
    eq.MidGain = mid
    eq.HighGain = hi
    eq.Parent = s
    return eq
end

local function PlayAt(pos, id, vol, speed, maxDist, lifetime, eqLo, eqMid, eqHi)
    local holder = Instance.new("Part")
    holder.Anchored = true
    holder.CanCollide = false
    holder.CanQuery = false
    holder.CanTouch = false
    holder.Transparency = 1
    holder.Size = Vector3.new(1, 1, 1)
    holder.Position = pos
    holder.Parent = Workspace

    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = vol * MASTER
    s.PlaybackSpeed = speed or 1
    s.RollOffMode = Enum.RollOffMode.InverseTapered
    s.RollOffMaxDistance = maxDist or 120
    pcall(function() s.RollOffMinDistance = 10 end)
    if eqLo then
        addEQ(s, eqLo, eqMid or 0, eqHi or 0)
    end
    s.Parent = holder
    s:Play()
    Debris:AddItem(holder, lifetime or 8)
    return s
end

