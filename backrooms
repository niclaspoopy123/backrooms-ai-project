-- 🌐 CHUNK STREAMING ------------------------------------------------------
local function QueueChunk(cx, cz)
    local name = cx .. "_" .. cz
    if loadedChunks[name] or queuedSet[name] then return end
    queuedSet[name] = true
    table.insert(chunkQueue, { cx, cz })
end

local function UnloadChunk(name)
    local c = loadedChunks[name]
    if c then
        c.Model:Destroy()
        loadedChunks[name] = nil
        litLights[name] = nil
    end
end

-- 🔊 ROOM-SIZE REVERB (level 0 only) ---------------------------------------
local reverbParams = RaycastParams.new()
reverbParams.FilterType = Enum.RaycastFilterType.Exclude
local avgRoomSize = nil

local function UpdateDynamicReverb()
    if HiveMind.CurrentLevel ~= 0 then avgRoomSize = nil return end
    local pos = Camera.CFrame.Position
    reverbParams.FilterDescendantsInstances = { Player.Character }
    local total = 0
    for i = 0, 7 do
        local a = i / 8 * math.pi * 2
        local r = Workspace:Raycast(pos, Vector3.new(math.cos(a), 0, math.sin(a)) * 80, reverbParams)
        total = total + (r and r.Distance or 80)
    end
    local avg = total / 8
    avgRoomSize = avgRoomSize and (avgRoomSize + (avg - avgRoomSize) * 0.5) or avg
    local want = (avgRoomSize < 12 and "Room") or (avgRoomSize < 30 and "Sewer") or (avgRoomSize < 55 and "Hall") or "Arena"
    if want ~= currentReverb then applyReverb(want) end
end

task.spawn(function()
    while RUNNING do
        pcall(UpdateDynamicReverb)
        task.wait(IS_MOBILE and 1 or 0.5)
    end
end)

