local function ComputeSharedSeed()
    local jid = tostring(game.JobId or "")
    if jid == "" or jid == "-1" or jid == "0" then
        return 20250601
    end
    local h = 2166136261
    for i = 1, #jid do
        h = (h * 16777619 + jid:byte(i)) % 4294967296
    end
    return (h % 999983) + 1
end

