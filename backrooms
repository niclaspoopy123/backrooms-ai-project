end

local function UpdateFootstepAcoustics(lvl)
    local lo, mid, hi
    if lvl == 0 then
        lo, mid, hi = 2, 1, -3
    elseif lvl == 1 then
        lo, mid, hi = -2, 2, 4
    else
        lo, mid, hi = 4, 0, -5
    end

    for _, fx in ipairs(FootstepSounds) do
        if fx.S.Parent then
            fx.eq.LowGain = lo
            fx.eq.MidGain = mid
            fx.eq.HighGain = hi
        end
    end
end

local function SetupFootsteps(char)
    task.spawn(function()
        local root = char:WaitForChild("HumanoidRootPart", 10)
        if not root or not RUNNING then return end
        if root:FindFirstChild("BRFootstepsL") or root:FindFirstChild("BRWalkLoop") then return end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local isLoopAsset = false
        do
            local probe = Instance.new("Sound")
            probe.SoundId = FOOTSTEP_ID
            probe.Volume = 0
            probe.Parent = root
            pcall(function() ContentProvider:PreloadAsync({probe}) end)
            if not probe.IsLoaded then
                pcall(function() probe:Play() end)
                local t0 = os.clock()
                while not probe.IsLoaded and os.clock() - t0 < 3 do
                    task.wait(0.1)
                end
                pcall(function() probe:Stop() end)
            end
            isLoopAsset = probe.TimeLength > 1.2
            probe:Destroy()
        end

        local land = Instance.new("Sound")
        land.Name = "BRLand"
        land.SoundId = THUMP_ID
        land.Volume = 0
        addEQ(land, 8, -6, -12)
        land.Parent = root

        if isLoopAsset then
            local walk = Instance.new("Sound")
            walk.Name = "BRWalkLoop"
            walk.SoundId = FOOTSTEP_ID
            walk.Looped = true
            walk.Volume = 0
            local eq = addEQ(walk, 2, 1, -3)
            walk.Parent = root
            table.clear(FootstepSounds)
            table.insert(FootstepSounds, { S = walk, eq = eq })
            UpdateFootstepAcoustics(HiveMind.CurrentLevel)

            local wasFalling, fallPeak = false, 0
            while RUNNING and root.Parent and hum.Parent do
                local dt = task.wait(0.05)
                local vel = root.AssemblyLinearVelocity
                local hSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude

                if vel.Y < -30 then
                    wasFalling = true
                    fallPeak = math.max(fallPeak, -vel.Y)
                elseif wasFalling and vel.Y > -5 then
                    wasFalling = false
                    local v = math.min(1, fallPeak / 60)
                    if v > 0.1 then
                        land.PlaybackSpeed = 0.55
                        land.Volume = v * 0.8 * MASTER
                        land:Play()
                    end
                    fallPeak = 0
                end

                local lvl = HiveMind.CurrentLevel
                if hSpeed > 2 then
                    if not walk.IsPlaying then walk:Play() end
                    local volMul = (lvl == 0 and 0.85) or (lvl == 1 and 1.0) or 0.75
                    local target = (0.5 + math.min(0.35, hSpeed / 60)) * volMul * MASTER
                    walk.Volume += (target - walk.Volume) * 0.3
                    local baseSpeed = (lvl == 1 and 0.94) or (lvl == 2 and 0.97) or 1.0
                    walk.PlaybackSpeed = baseSpeed + math.sin(os.clock() * 1.7) * 0.012
                else
                    walk.Volume += (0 - walk.Volume) * 0.35
                    if walk.Volume < 0.02 and walk.IsPlaying then
                        walk:Pause()
                    end
                end
            end
            return
        end

        local function makeStep(name)
            local s = Instance.new("Sound")
            s.Name = name
            s.SoundId = FOOTSTEP_ID
            s.Volume = 0.55
            local eq = addEQ(s, 2, 1, -3)
            s.Parent = root
            return s, eq
        end

        table.clear(FootstepSounds)
        local fsL, e1 = makeStep("BRFootstepsL")
        local fsR, e2 = makeStep("BRFootstepsR")
        local fsS, e3 = makeStep("BRFootstepScuff")
        table.insert(FootstepSounds, { S = fsL, eq = e1 })
        table.insert(FootstepSounds, { S = fsR, eq = e2 })
        table.insert(FootstepSounds, { S = fsS, eq = e3 })
        UpdateFootstepAcoustics(HiveMind.CurrentLevel)

        local function scuffAfter(main)
            task.delay(0.02 + math.random() * 0.03, function()
                if fsS.Parent then
                    fsS.PlaybackSpeed = 1.1 + math.random() * 0.07
                    fsS.Volume = main.Volume * 0.2
                    fsS:Play()
                end
            end)
        end

        local stride = 9.5
        local stepAccum = 0
        local left = false
        local wasFalling, fallPeak = false, 0

        while RUNNING and root.Parent and hum.Parent do
            local dt = task.wait(0.05)
            local vel = root.AssemblyLinearVelocity
            local hSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude

            if vel.Y < -30 then
                wasFalling = true
                fallPeak = math.max(fallPeak, -vel.Y)
            elseif wasFalling and vel.Y > -5 then
                wasFalling = false
                local v = math.min(1, fallPeak / 60)
                if v > 0.1 then
                    land.PlaybackSpeed = 0.55
                    land.Volume = v * 0.8 * MASTER
                    land:Play()
                end
                fallPeak = 0
                stepAccum = stride * 0.5
            end

            if hSpeed > 2 then
                stepAccum += dt * hSpeed
                if stepAccum >= stride then
                    stepAccum = 0
                    left = not left
                    local lvl = HiveMind.CurrentLevel
                    local base, span, volMul
                    if lvl == 0 then
                        base, span, volMul = 1.00, 0.05, 0.85
                    elseif lvl == 1 then
                        base, span, volMul = 0.93, 0.05, 1.00
                    else
                        base, span, volMul = 0.98, 0.04, 0.80
                    end
                    local s = left and fsL or fsR
                    s.PlaybackSpeed = base + (left and 0 or 0.03) + math.random() * span
                    s.Volume = (0.42 + math.min(0.3, hSpeed / 55)) * volMul * MASTER
                    s:Play()
                    scuffAfter(s)
                    if math.random() < 0.05 then
                        PlayAt(root.Position, CREAK_ID, 0.09, 1.6 + math.random() * 0.5, 30, 2, 2, 0, -4)
                    end
                end
            else
                stepAccum = stride * 0.5
            end
        end
    end)
end

