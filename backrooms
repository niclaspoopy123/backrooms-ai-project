    local function makeAmbience(name, id, vol, speed, lo, mid, hi)
        local s = Instance.new("Sound")
        s.Name = name
        s.SoundId = id
        s.Volume = vol * MASTER
        s.PlaybackSpeed = speed
        s.Looped = true
        s.SoundGroup = BRMasterGroup
        if lo then addEQ(s, lo, mid, hi) end
        s.Parent = SoundService
        s:Play()
        return s
    end

    sounds.Lvl0 = makeAmbience("AmbienceLvl0", AUDIO_LEVEL_0, 0.4, 1, 1, 0, -2)
    -- low room-tone layer under the fluorescent buzz (same asset, slowed and low-passed)
