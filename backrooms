local SEED_A = (SEED % 89) / 89 * 10
local SEED_B = (SEED % 83) / 83 * 10
local SEED_C = (SEED % 71) / 71 * 10

local function MakeRNG(cx, cz)
    local state = (SEED * 73856093 + cx * 19349663 + cz * 83492791) % 2147483647
    if state <= 0 then state = 1 end
    return function()
        state = (state * 16807) % 2147483647
        return (state - 1) / 2147483646
    end
end

local function CreateWallPart(parent, alongZ, worldX, worldZ, wTex, wCol, material, rng)
    local wall = Instance.new("Part")
    Solid(wall)
    wall.Material = material
    local c = JitterColor(wCol, 0.10, rng)
    if alongZ then
        wall.Size = Vector3.new(1, WALL_H, WALL_SPACING)
        wall.Position = Vector3.new(worldX, WALL_H / 2, worldZ)
        ApplyTexture(wall, wTex, Enum.NormalId.Left, c, 8, 0)
        ApplyTexture(wall, wTex, Enum.NormalId.Right, c, 8, 0)
    else
        wall.Size = Vector3.new(WALL_SPACING, WALL_H, 1)
        wall.Position = Vector3.new(worldX, WALL_H / 2, worldZ)
        ApplyTexture(wall, wTex, Enum.NormalId.Front, c, 8, 0)
        ApplyTexture(wall, wTex, Enum.NormalId.Back, c, 8, 0)
    end
    wall.Parent = parent
    return wall
end

local function CreateDoorway(parent, alongZ, worldX, worldZ, wTex, wCol, material, rng)
    local gap = 6
    local off = (rng() - 0.5) * (WALL_SPACING - gap - 3)
    local sideL = (WALL_SPACING - gap) / 2 + off
    local sideR = (WALL_SPACING - gap) / 2 - off

    local function piece(len, centerOff)
        if len < 0.8 then return end
        local p = Instance.new("Part")
        Solid(p)
        p.Material = material
        local c = JitterColor(wCol, 0.10, rng)
        if alongZ then
            p.Size = Vector3.new(1, WALL_H, len)
            p.Position = Vector3.new(worldX, WALL_H / 2, worldZ + centerOff)
            ApplyTexture(p, wTex, Enum.NormalId.Left, c, 8, 0)
            ApplyTexture(p, wTex, Enum.NormalId.Right, c, 8, 0)
        else
            p.Size = Vector3.new(len, WALL_H, 1)
            p.Position = Vector3.new(worldX + centerOff, WALL_H / 2, worldZ)
            ApplyTexture(p, wTex, Enum.NormalId.Front, c, 8, 0)
            ApplyTexture(p, wTex, Enum.NormalId.Back, c, 8, 0)
        end
        p.Parent = parent
    end

    piece(sideL, -(gap / 2 + sideL / 2))
    piece(sideR, (gap / 2 + sideR / 2))

    local head = Instance.new("Part")
    Solid(head)
    head.Material = material
    local hc = JitterColor(wCol, 0.10, rng)
    if alongZ then
        head.Size = Vector3.new(1, WALL_H - 7.5, gap)
        head.Position = Vector3.new(worldX, 7.5 + (WALL_H - 7.5) / 2, worldZ + off)
        ApplyTexture(head, wTex, Enum.NormalId.Left, hc, 8, 0)
        ApplyTexture(head, wTex, Enum.NormalId.Right, hc, 8, 0)
    else
        head.Size = Vector3.new(gap, WALL_H - 7.5, 1)
        head.Position = Vector3.new(worldX + off, 7.5 + (WALL_H - 7.5) / 2, worldZ)
        ApplyTexture(head, wTex, Enum.NormalId.Front, hc, 8, 0)
        ApplyTexture(head, wTex, Enum.NormalId.Back, hc, 8, 0)
    end
    head.Parent = parent

    for _, s in ipairs({-1, 1}) do
        local trim = Instance.new("Part")
        Ghost(trim)
        trim.Material = Enum.Material.Wood
        trim.Color = Color3.fromRGB(96, 76, 48)
        if alongZ then
            trim.Size = Vector3.new(1.4, 7.7, 0.45)
            trim.Position = Vector3.new(worldX, 3.85, worldZ + off + s * (gap / 2))
        else
            trim.Size = Vector3.new(0.45, 7.7, 1.4)
            trim.Position = Vector3.new(worldX + off + s * (gap / 2), 3.85, worldZ)
        end
        trim.Parent = parent
    end
end

local function CreateCeilingTile(chunk, data, x, z, level, gx, gz, rng)
    local isLightTile = (gx % 2 == 0) and (gz % 2 == 0)

    local tile = Instance.new("Part")
    Solid(tile)
