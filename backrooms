-- 💡 LIGHT SAFETY
local function RegisterLit(key, pos, light)
    litLights[key] = litLights[key] or {}
    table.insert(litLights[key], { Pos = pos, Light = light })
end

local function GetPlayerLightSafety()
    local p = HiveMind.PlayerPos
    if p.Y > 9 then return false end
    local ccx = math.floor(p.X / CHUNK_SIZE + 0.5)
    local ccz = math.floor(p.Z / CHUNK_SIZE + 0.5)
    for dx = -1, 1 do
        for dz = -1, 1 do
            local list = litLights[(ccx + dx) .. "_" .. (ccz + dz)]
            if list then
                for _, e in ipairs(list) do
                    if e.Light.Parent and e.Light.Brightness > LIGHT_SAFE_MIN then
                        local horiz = Vector3.new(e.Pos.X - p.X, 0, e.Pos.Z - p.Z).Magnitude
                        if horiz < LIGHT_SAFE_RADIUS then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- 🔊 SOUND HELPERS -------------------------------------------------------
local function addEQ(s, lo, mid, hi)
    local eq = Instance.new("EqualizerSoundEffect")
    eq.LowGain = lo
    eq.MidGain = mid
    eq.HighGain = hi
    eq.Parent = s
    return eq
end

-- shared sound group with a compressor so stacked sounds never clip
local BRMasterGroup = SoundService:FindFirstChild("BRMasterGroup")
if BRMasterGroup then BRMasterGroup:Destroy() end
BRMasterGroup = Instance.new("SoundGroup")
BRMasterGroup.Name = "BRMasterGroup"
BRMasterGroup.Volume = 1
BRMasterGroup.Parent = SoundService
do
    local comp = Instance.new("CompressorSoundEffect")
    comp.Threshold = -14
    comp.Ratio = 6
    comp.Attack = 0.01
    comp.Release = 0.2
    comp.Parent = BRMasterGroup
end

local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude

-- muffle a sound when a wall sits between it and the camera (one ray per sound)
local function ApplyOcclusion(s, pos, maxDist)
    local camPos = Camera.CFrame.Position
    local offset = pos - camPos
    local dist = offset.Magnitude
    if dist < 6 or dist > (maxDist or 120) then return end
    occlusionParams.FilterDescendantsInstances = { Player.Character }
    local hit = Workspace:Raycast(camPos, offset, occlusionParams)
    if not hit or (hit.Position - pos).Magnitude <= 2 then return end
    local f = math.clamp(dist / 60, 0, 1)
    local eq = s:FindFirstChildOfClass("EqualizerSoundEffect") or addEQ(s, 0, 0, 0)
    eq.HighGain = eq.HighGain - (6 + 14 * f)
    eq.MidGain = eq.MidGain - (2 + 4 * f)
    s.Volume = s.Volume * (1 - 0.3 * f)
end

local function PlayAt(pos, id, vol, speed, maxDist, lifetime, eqLo, eqMid, eqHi)
    local holder = Instance.new("Part")
    holder.Anchored = true
    holder.CanCollide = false
    holder.CanQuery = false
    holder.CanTouch = false
    holder.Transparency = 1
    holder.Size = Vector3.new(1, 1, 1)
    holder.Position = pos
    holder.Parent = Workspace
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = vol * MASTER
    s.PlaybackSpeed = speed or 1
    s.RollOffMode = Enum.RollOffMode.InverseTapered
    s.RollOffMaxDistance = maxDist or 120
    s.SoundGroup = BRMasterGroup
    pcall(function() s.RollOffMinDistance = 10 end)
    if eqLo then addEQ(s, eqLo, eqMid or 0, eqHi or 0) end
    pcall(ApplyOcclusion, s, pos, maxDist)
    s.Parent = holder
    s:Play()
    Debris:AddItem(holder, lifetime or 8)
    return s
end

