local SEED_A = (SEED % 89) / 89 * 10
local SEED_B = (SEED % 83) / 83 * 10
local SEED_C = (SEED % 71) / 71 * 10

local function MakeRNG(cx, cz)
    local state = (SEED * 73856093 + cx * 19349663 + cz * 83492791) % 2147483647
    if state <= 0 then state = 1 end
    return function()
        state = (state * 16807) % 2147483647
        return (state - 1) / 2147483646
    end
end

local function CreateWallPart(parent, alongZ, worldX, worldZ, wTex, wCol, material, rng)
    local wall = Instance.new("Part")
    Solid(wall)
    wall.Material = material
    local c = JitterColor(wCol, 0.10, rng)
    if alongZ then
        wall.Size = Vector3.new(1, WALL_H, WALL_SPACING)
